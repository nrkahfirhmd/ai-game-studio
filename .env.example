# All inference runs locally. No API key, no cloud account, no per-request cost.
# The defaults below match a standard Ollama + ComfyUI install — copy to .env
# and only change what you need.

# --- Text (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b

# --- Reference sprite (ComfyUI, FLUX.1 Schnell) ---
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_MODEL=flux1-schnell-fp8.safetensors
IMAGE_SIZE=1024x1024
# Lower-memory: point COMFYUI_IMAGE_MODEL at a .gguf in ComfyUI/models/unet/
# (needs the ComfyUI-GGUF custom node). These three are only read for .gguf:
# COMFYUI_IMAGE_MODEL=flux1-schnell-Q4_K_S.gguf
# COMFYUI_T5_MODEL=t5xxl_fp8_e4m3fn.safetensors
# COMFYUI_CLIP_MODEL=clip_l.safetensors
# COMFYUI_VAE_MODEL=ae.safetensors

# --- Movement frames (ComfyUI image-to-video) ---
# Default: Stable Video Diffusion. Put svd_xt.safetensors in
# ComfyUI/models/checkpoints/ (~9 GB, from stabilityai/stable-video-diffusion-img2vid-xt).
COMFYUI_VIDEO_MODEL=svd_xt.safetensors
VIDEO_FRAMES=25            # 8n+1 for LTX-Video (17, 25, 41…)
VIDEO_MOTION=127           # SVD motion strength, 1–255
VIDEO_STEPS=20
VIDEO_SIZE=768x768         # match the sprite aspect to avoid rescale/cropping
VIDEO_STRENGTH=0.85        # single-image LTX: faithfulness to the sprite (higher = less drift)

# Two-keyframe mode: FLUX generates an end-pose sprite, the video model
# interpolates start -> end. Needed for directed motion (attack, jump); a single
# still can only do idle/sway. 0 = off.
# FLUX Schnell ceiling: 0.7–0.8 keeps the character (subtle motion), 0.9+ gets a
# real pose but a different character. For crisp attacks use a FLUX Dev / SDXL+
# ControlNet workflow via COMFYUI_ENDPOSE_WORKFLOW.
VIDEO_ENDPOSE_DENOISE=0
VIDEO_END_STRENGTH=0.7    # how hard LTX pins the end pose (lower = blends character back)
# For crisp attacks/jumps: SDXL + OpenPose ControlNet end-pose rig.
# See docs/controlnet-endpose-setup.md for the model + custom-node downloads.
# COMFYUI_ENDPOSE_WORKFLOW=server/workflows/endpose-controlnet.json

# Use a custom workflow instead of SVD. Ships: server/workflows/ltxv-i2v.json
# (single image) and ltxv-keyframes.json (two-keyframe, pair with
# VIDEO_ENDPOSE_DENOISE>0). Or export your own — see server/workflows/README.md.
# COMFYUI_VIDEO_WORKFLOW=server/workflows/ltxv-keyframes.json

# Per-generation wait cap (seconds). Video on modest hardware is slow.
COMFYUI_TIMEOUT_S=600

# --- Features ---
ENABLE_PROMPT_ENHANCER=true

# --- Server ---
PORT=8787
